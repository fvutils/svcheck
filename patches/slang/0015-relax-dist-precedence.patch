+    /// Parse the `dist` of an expression_or_dist over the whole expression, as its
+    /// grammar reads (`a == b dist {...}` is `(a == b) dist {...}`), rather than at the
+    /// precedence of `inside` that Table 11-2 gives it.
+    bool distOverWholeExpression = false;
 };
 
