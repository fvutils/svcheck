+// RelaxForwardMethodRefs: a method of the class being searched may be named before its
+// declaration even when it returns a value and is called without parentheses.
+static bool forwardMethodRef(const Scope& scope) {
+    return scope.asSymbol().kind == SymbolKind::ClassType &&
+           scope.getCompilation().hasFlag(CompilationFlags::RelaxForwardMethodRefs);
+}
