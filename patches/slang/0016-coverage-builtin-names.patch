+// A covergroup's built-in methods (start, stop, ...) do not hide an argument of the
+// covergroup, or of its sample() method, of the same name: those are in the covergroup
+// type's scope, the parent of the body that holds the built-ins.
+static bool covergroupBuiltinHidesArg(const Scope& scope, const Symbol& symbol,
+                                      std::string_view name) {
+    if (scope.asSymbol().kind != SymbolKind::CovergroupBody ||
+        symbol.kind != SymbolKind::Subroutine) {
+        return false;
+    }
+
+    auto last = scope.asSymbol().as<CovergroupBodySymbol>().getLastBuiltinMember();
+    if (!last || symbol.getIndex() > last->getIndex())
+        return false;
+
+    auto parent = scope.asSymbol().getParentScope();
+    auto arg = parent ? parent->find(name) : nullptr;
+    return arg && arg->kind == SymbolKind::FormalArgument;
+}
